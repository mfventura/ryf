<div class="{{cssClass}} flexcol sheet-content">

  <header class="sheet-header spell-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editImage" title="{{item.name}}" height="48" width="48"/>
    <div class="header-fields">
      <input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'RYF.Combat.AttackName'}}" class="spell-name-input"/>
    </div>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-action="changeTab" data-tab="details">{{localize "RYF.Tabs.Details"}}</a>
    <a class="item" data-action="changeTab" data-tab="description">{{localize "RYF.Tabs.Description"}}</a>
  </nav>

  <section class="sheet-body">

    <div class="tab description" data-group="primary" data-tab="description">
      <div class="editor-content">
        <prose-mirror name="system.description" value="{{system.description}}" toggled>{{{enrichedDescription}}}</prose-mirror>
      </div>
    </div>

    <div class="tab details" data-group="primary" data-tab="details">
      
      <div class="form-group">
        <label>{{localize "RYF.Combat.AttackType"}}</label>
        <select name="system.attackType" data-dtype="String">
          <option value="melee" {{#if (eq system.attackType "melee")}}selected{{/if}}>{{localize "RYF.Melee"}}</option>
          <option value="ranged" {{#if (eq system.attackType "ranged")}}selected{{/if}}>{{localize "RYF.Magic.AttackTypes.ranged"}}</option>
        </select>
      </div>

      <div class="form-group">
        <label>{{localize "RYF.AttackBonus"}}</label>
        <input type="number" name="system.attackBonus" value="{{system.attackBonus}}" data-dtype="Number" placeholder="0"/>
      </div>

      <h3>{{localize "RYF.Damage"}}</h3>

      <div class="form-group">
        <label>{{localize "RYF.BaseDamage"}}</label>
        <input type="text" name="system.damage.base" value="{{system.damage.base}}" placeholder="1d6"/>
      </div>

      <div class="form-group">
        <label>{{localize "RYF.DamageBonus"}}</label>
        <input type="number" name="system.damage.bonus" value="{{system.damage.bonus}}" data-dtype="Number" placeholder="0"/>
      </div>

    </div>

  </section>
</div>

