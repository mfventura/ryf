{{!-- Reference: RyF 3.0 PDF, páginas 103-104 - combate y persecución de naves:
      cada nave tira su lado por separado y los totales se comparan en el chat --}}
<div class="ryf-roll ship-roll">
  <div class="roll-header">
    <img src="{{ship.img}}" alt="{{ship.name}}" class="actor-image"/>
    <div class="roll-title">
      <h3>
        {{#if (eq contest "attack")}}
        <i class="fas fa-crosshairs"></i> {{localize "RYF.Ship.AttackTitle"}}
        {{else if (eq contest "defense")}}
        <i class="fas fa-shield-alt"></i> {{localize "RYF.Ship.DefenseTitle"}}
        {{else}}
        <i class="fas fa-gauge-high"></i> {{localize "RYF.Ship.ChaseTitle"}}
        {{/if}}
      </h3>
      <div class="roll-subtitle">
        {{ship.name}}
        {{#if bonusSource}} — {{#if (eq contest "attack")}}{{localize "RYF.Ship.Gunner"}}{{else}}{{localize "RYF.Ship.Pilot"}}{{/if}}: {{bonusSource}}{{/if}}
        {{#if weaponLabel}} — {{weaponLabel}}{{/if}}
      </div>
    </div>
  </div>

  <div class="roll-formula">
    <span class="formula-part">
      {{#if (eq contest "attack")}}{{localize "RYF.Ship.Gunner"}}{{else}}{{localize "RYF.Ship.Pilot"}}{{/if}}: {{bonus}}
    </span>
    <span class="formula-separator">+</span>
    <span class="formula-part">
      {{#if (eq statKey "maneuverability")}}{{localize "RYF.Ship.Maneuverability"}}{{else}}{{localize "RYF.Ship.Speed"}}{{/if}}: {{shipStat}}
    </span>
    <span class="formula-separator">+</span>
    <span class="formula-part dice-part">{{diceRoll.chosen}}</span>
    {{#if (gt modifier 0)}}
    <span class="formula-separator">+</span>
    <span class="formula-part modifier-bonus">{{localize "RYF.Modifier"}}: +{{modifier}}</span>
    {{else if (lt modifier 0)}}
    <span class="formula-separator">-</span>
    <span class="formula-part modifier-penalty">{{localize "RYF.Modifier"}}: {{modifier}}</span>
    {{/if}}
  </div>

  <div class="dice-results">
    <div class="dice-pool">
      {{#each diceRoll.sorted as |die index|}}
        <div class="die d10 {{#if (eq index diceRoll.chosenIndex)}}chosen{{/if}}">
          <i class="fas fa-dice-d10"></i>
          <span class="die-value">{{die}}</span>
        </div>
      {{/each}}
    </div>

    {{#if diceRoll.exploded}}
    <div class="explosions">
      <i class="fas fa-burst"></i> {{localize "RYF.Exploded"}}:
      {{#each diceRoll.explosions as |explosion|}}
        <span class="explosion-value">+{{explosion}}</span>
      {{/each}}
    </div>
    {{/if}}
  </div>

  <div class="roll-result">
    <div class="result-total {{#if fumble}}failure{{else}}success{{/if}}">
      <span class="result-label">{{localize "RYF.Total"}}</span>
      <span class="result-value">{{total}}</span>
    </div>
  </div>

  {{#if fumble}}
  <div class="roll-outcome">
    <div class="outcome fumble">
      <i class="fas fa-skull-crossbones"></i> <strong>{{localize "RYF.Fumble"}}</strong>
    </div>
  </div>
  {{else if naturalOne}}
  <div class="roll-outcome">
    <div class="outcome failure">
      <i class="fas fa-exclamation-triangle"></i> <strong>{{localize "RYF.Ship.NaturalOne"}}</strong>
    </div>
  </div>
  {{/if}}

  <div class="ship-compare-note">
    <i class="fas fa-info-circle"></i> {{localize "RYF.Ship.CompareNote"}}
  </div>

  {{#if damageFormula}}
  <div class="damage-actions">
    <button type="button" class="ship-roll-damage" data-damage-formula="{{damageFormula}}" data-weapon-label="{{weaponLabel}}">
      <i class="fas fa-dice-d6"></i> {{localize "RYF.RollDamage"}} ({{damageFormula}})
    </button>
  </div>
  {{/if}}
</div>
