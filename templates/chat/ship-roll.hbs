{{!-- Reference: RyF 3.0 PDF, páginas 103-104 - combate y persecución de naves --}}
<div class="ryf-roll ship-roll">
  <div class="roll-header">
    <img src="{{attacker.ship.img}}" alt="{{attacker.ship.name}}" class="actor-image"/>
    <div class="roll-title">
      <h3>
        {{#if (eq contest "attack")}}
        <i class="fas fa-rocket"></i> {{localize "RYF.Ship.AttackTitle"}}
        {{else}}
        <i class="fas fa-gauge-high"></i> {{localize "RYF.Ship.ChaseTitle"}}
        {{/if}}
      </h3>
      <div class="roll-subtitle">{{attacker.ship.name}} vs {{defender.ship.name}}</div>
    </div>
  </div>

  <div class="ship-sides">
    <div class="ship-side attacker">
      <div class="side-name">
        <strong>{{attacker.ship.name}}</strong>
        <span class="side-role">
          {{#if (eq contest "attack")}}{{localize "RYF.Ship.GunnerBonus"}}{{else}}{{localize "RYF.Ship.PilotBonus"}}{{/if}}
        </span>
      </div>
      <div class="roll-formula">
        <span class="formula-part">{{localize "RYF.Bonus"}}: {{attacker.bonus}}</span>
        <span class="formula-separator">+</span>
        <span class="formula-part">
          {{#if (eq statKey "maneuverability")}}{{localize "RYF.Ship.Maneuverability"}}{{else}}{{localize "RYF.Ship.Speed"}}{{/if}}: {{attacker.shipStat}}
        </span>
        <span class="formula-separator">+</span>
        <span class="formula-part dice-part">{{attacker.diceRoll.chosen}}</span>
        {{#if attacker.diceRoll.exploded}}
        <span class="explosions"><i class="fas fa-burst"></i>
          {{#each attacker.diceRoll.explosions as |explosion|}}<span class="explosion-value">+{{explosion}}</span>{{/each}}
        </span>
        {{/if}}
      </div>
      <div class="side-total {{#if attacker.fumble}}fumble{{/if}}">
        {{localize "RYF.Total"}}: <strong>{{attacker.total}}</strong>
        {{#if attacker.fumble}}<span class="fumble-tag"><i class="fas fa-skull-crossbones"></i> {{localize "RYF.Fumble"}}</span>
        {{else if attacker.naturalOne}}<span class="fumble-tag">1</span>{{/if}}
      </div>
    </div>

    <div class="ship-side defender">
      <div class="side-name">
        <strong>{{defender.ship.name}}</strong>
        <span class="side-role">{{localize "RYF.Ship.PilotBonus"}}</span>
      </div>
      <div class="roll-formula">
        <span class="formula-part">{{localize "RYF.Bonus"}}: {{defender.bonus}}</span>
        <span class="formula-separator">+</span>
        <span class="formula-part">
          {{#if (eq statKey "maneuverability")}}{{localize "RYF.Ship.Maneuverability"}}{{else}}{{localize "RYF.Ship.Speed"}}{{/if}}: {{defender.shipStat}}
        </span>
        <span class="formula-separator">+</span>
        <span class="formula-part dice-part">{{defender.diceRoll.chosen}}</span>
        {{#if defender.diceRoll.exploded}}
        <span class="explosions"><i class="fas fa-burst"></i>
          {{#each defender.diceRoll.explosions as |explosion|}}<span class="explosion-value">+{{explosion}}</span>{{/each}}
        </span>
        {{/if}}
      </div>
      <div class="side-total {{#if defender.fumble}}fumble{{/if}}">
        {{localize "RYF.Total"}}: <strong>{{defender.total}}</strong>
        {{#if defender.fumble}}<span class="fumble-tag"><i class="fas fa-skull-crossbones"></i> {{localize "RYF.Fumble"}}</span>
        {{else if defender.naturalOne}}<span class="fumble-tag">1</span>{{/if}}
      </div>
    </div>
  </div>

  <div class="roll-outcome">
    {{#if tie}}
    <div class="outcome tie">
      <i class="fas fa-balance-scale"></i> <strong>{{localize "RYF.Ship.Tie"}}</strong>
    </div>
    {{else if (eq winner "attacker")}}
    <div class="outcome success">
      <i class="fas fa-bullseye"></i>
      <strong>
        {{#if (eq contest "attack")}}{{localize "RYF.Ship.AttackerHits"}}{{else}}{{localize "RYF.Ship.ChaserCloses"}}{{/if}}
      </strong>
    </div>
    {{else}}
    <div class="outcome failure">
      <i class="fas fa-shield-alt"></i>
      <strong>
        {{#if (eq contest "attack")}}{{localize "RYF.Ship.DefenderEvades"}}{{else}}{{localize "RYF.Ship.ChasedEscapes"}}{{/if}}
      </strong>
    </div>
    {{/if}}
  </div>

  {{#if damageRoll}}
  <div class="ship-damage">
    <div class="section-label">
      {{localize "RYF.Damage"}}{{#if weaponLabel}} — {{weaponLabel}}{{/if}} ({{damageFormula}})
    </div>
    <div class="dice-results">
      {{#each damageRoll.rolls as |roll|}}
      <div class="die d6"><i class="fas fa-dice-d6"></i><span class="die-value">{{roll}}</span></div>
      {{/each}}
      {{#if damageRoll.explosions.length}}
      <div class="explosions">
        <i class="fas fa-burst"></i>
        {{#each damageRoll.explosions as |explosion|}}<span class="explosion-value">+{{explosion}}</span>{{/each}}
      </div>
      {{/if}}
    </div>
    <div class="damage-total">
      <div class="total-label">{{localize "RYF.TotalDamage"}}</div>
      <div class="total-value">{{damageRoll.total}}</div>
    </div>
    <div class="damage-actions">
      <button type="button" class="apply-damage-button" data-damage="{{damageRoll.total}}" data-damage-type="physical">
        <i class="fas fa-heart-broken"></i> {{localize "RYF.Combat.ApplyDamage"}}
      </button>
    </div>
  </div>
  {{/if}}
</div>
